# Copy to .env.local (gitignored by the .env* rule). Names only — never values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never NEXT_PUBLIC_, never in the repo, never in CI config.
SUPABASE_SERVICE_ROLE_KEY=
# Applies a migration to the LIVE project: npm run migrate:live <file> (#114).
# A PERSONAL ACCESS TOKEN, not a project key — mint it on the ACCOUNT page,
# https://supabase.com/dashboard/account/tokens, and revoke it there too.
# SCOPED BY PROJECT AND BY PERMISSION, measured 2026-08-31: it must cover THIS
# project and allow writes. One scoped to another project answers 403 to every
# endpoint here; a read-only one reads fine and answers 25006 to every write.
# `GET /v1/projects` lists exactly what a token covers, which is the one call
# that tells you which of those two you are holding.
# Still the widest credential in this file: the anon key is public by design and
# subject to RLS, and the service-role key cannot run DDL at all. Unset, every
# migrate:live run refuses before it sends anything; a dry run needs no token.
SUPABASE_ACCESS_TOKEN=
RESEND_API_KEY=
# Signs the gate pass a new member carries through Google sign-up (#70). Any long random string.
GATE_PASS_SECRET=
# The bearer secret a scheduler presents to /api/ladder/tick (#25). Any long random string.
# UNSET REFUSES EVERY CALL, deliberately — see src/auth/bearer.ts. #26 stores it in Supabase
# Vault for pg_cron and in Vercel's environment for the daily sweep, and adds the runbook step.
CRON_SECRET=
# Web push (VAPID). Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
